  inicio --> PENDING
  PENDING -- "dependencias con éxito" --> READY
  PENDING -- "una dependencia sin éxito" --> SKIPPED
  READY -- "acierto de caché" --> SUCCEEDED
  READY -- "intento lanzado" --> RUNNING
  RUNNING -- "código 0" --> SUCCEEDED
  RUNNING -- "fallo reintentable" --> RETRY_WAIT
  RETRY_WAIT -- "intento nuevo" --> RUNNING
  RUNNING -- "fallo de tarea definitivo" --> FAILED
  RUNNING -- "fallo de infraestructura definitivo" --> ERROR

